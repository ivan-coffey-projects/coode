{
  "name": "@coode/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "coode-server": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@coode/core": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
